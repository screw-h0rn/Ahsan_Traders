{
  "name": "ahsan-traders",
  "version": "1.0.0",
  "private": true,
  "description": "Distribution management system for Ahsan Traders — web portal, mobile API, single business",
  "engines": {
    "node": ">=22",
    "pnpm": ">=10"
  },
  "packageManager": "pnpm@10.32.0",
  "scripts": {
    "dev": "pnpm --filter @at/web dev",
    "build": "pnpm -r build",
    "lint": "eslint shared packages && pnpm --filter @at/web lint",
    "typecheck": "pnpm -r typecheck",
    "test": "pnpm -r test",
    "db:push": "cd backend && set -a && . ./.env && set +a && pnpm exec supabase db push --db-url \"$SUPABASE_DB_URL\"",
    "db:local": "node backend/tests/local-db.mjs",
    "db:verify": "node backend/tests/schema-verify.mjs",
    "audit:db": "node backend/tests/security-audit.mjs",
    "test:flows": "node backend/tests/business-flows.mjs",
    "gen:types": "cd backend && set -a && . ./.env && set +a && pnpm exec supabase gen types typescript --db-url \"$SUPABASE_DB_URL\" --schema public",
    "format": "prettier --write \"**/*.{ts,tsx,js,jsx,json,md,css,sql}\"",
    "format:check": "prettier --check \"**/*.{ts,tsx,js,jsx,json,md,css}\""
  },
  "devDependencies": {
    "@eslint/js": "^9.18.0",
    "@supabase/supabase-js": "^2.108.2",
    "eslint": "^9.18.0",
    "globals": "^15.14.0",
    "pg": "^8.22.0",
    "prettier": "^3.4.2",
    "supabase": "^2.108.0",
    "typescript": "^5.7.3",
    "typescript-eslint": "^8.20.0"
  }
}
